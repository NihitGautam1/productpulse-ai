# Copy this file to .env and fill in your own values. Never commit .env.

# Which AI provider to use: "gemini" (Google, free tier available) or "anthropic" (Claude).
# If omitted, it is guessed from the key: keys starting with "sk-ant-" use Claude, others use Gemini.
AI_PROVIDER=gemini

# Gemini keys: https://aistudio.google.com/apikey   Claude keys: https://console.anthropic.com/
AI_API_KEY=your_api_key_here

# Optional. Defaults: gemini-flash-latest (Gemini) or claude-haiku-4-5 (Claude).
# AI_MODEL=gemini-flash-latest
